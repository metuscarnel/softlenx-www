---
import DataVisualShowcase from './DataVisualShowcase.astro';
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-content">
      <p class="hero-label">Média d'information socioéconomique · Bénin</p>
      <h1 class="hero-title">Au-delà des <span class="highlight">chiffres</span>.</h1>
      <p class="hero-text">Nous démocratisons l’information sur la conjoncture socioéconomique du Bénin et ses implications dans le quotidien des Béninoises et des Béninois.</p>
      <a href="#mission" class="cta-button">Découvrir notre mission</a>
    </div>
    <div class="hero-visual">
      <DataVisualShowcase />
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 78vh;
    display: flex;
    align-items: center;
    padding: var(--space-xxl) 0;
    animation: hero-fade-in 1s ease-out forwards;
  }

  @keyframes hero-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.25rem, 2.2vw, 2.25rem);
    align-items: center;
    width: 100%;
  }

  .hero-content {
    max-width: 640px;
    text-align: left;
  }

  .hero-visual {
    display: flex;
    justify-content: flex-end;
  }

  .hero-label {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: var(--space-md);
    animation: hero-child-fade-in 0.8s 0.2s ease-out forwards;
    opacity: 0;
  }

  .hero-title {
    font-size: clamp(3.5rem, 8vw, 6rem);
    font-weight: 700;
    margin-bottom: var(--space-md);
    animation: hero-child-fade-in 0.8s 0.4s ease-out forwards;
    opacity: 0;
  }

  .hero-title .highlight {
    color: var(--color-accent-primary);
  }

  .hero-text {
    font-size: 1.25rem;
    max-width: 650px;
    margin: 0 0 var(--space-lg);
    animation: hero-child-fade-in 0.8s 0.6s ease-out forwards;
    opacity: 0;
  }

  .hero-content .cta-button {
    animation: hero-child-fade-in 0.8s 0.8s ease-out forwards;
    opacity: 0;
  }

  @keyframes hero-child-fade-in {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 860px) {
    .hero {
      min-height: 70vh;
      padding-top: var(--space-xl);
      padding-bottom: var(--space-xl);
    }

    .hero-grid {
      grid-template-columns: 1fr;
    }

    .hero-content {
      text-align: center;
      margin-inline: auto;
    }

    .hero-text {
      margin-inline: auto;
    }
  }
</style>