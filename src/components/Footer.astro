---
import logoSrc from '../assets/logos/sl-softlenx-logo.svg';
---
<footer class="main-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-identity">
        <a href="/" aria-label="Retour à l'accueil de Softlenx">
          <img src={logoSrc.src} alt="Logo Softlenx" />
        </a>
        <p class="slogan">Au-delà des chiffres.</p>
        <p class="description">Média de démocratisation de l'information socioéconomique au Bénin.</p>
      </div>
      <div class="footer-nav">
        <div class="nav-column">
          <h4>Navigation</h4>
          <ul>
            <li><a href="#mission">La mission</a></li>
            <li><a href="#demarche">La démarche</a></li>
            <li><a href="#thematiques">Les thématiques</a></li>
            <li><a href="#exigences">Nos exigences</a></li>
            <li><a href="#suivre">Nous suivre</a></li>
          </ul>
        </div>
        <div class="nav-column">
          <h4>Informations</h4>
          <ul>
            <li><a href="#">À propos</a></li>
            <li><a href="#">Contact</a></li>
            <li><a href="#">Politique de confidentialité</a></li>
            <li><a href="#">Politique relative aux cookies</a></li>
            <li><a href="#">Mentions légales</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} Softlenx. Tous droits réservés.</p>
    </div>
  </div>
</footer>

<style>
  .main-footer {
    background-color: var(--color-ink-navy);
    color: rgba(247, 245, 240, 0.7); /* Paper à 70% */
    padding-top: var(--space-xl);
    font-size: 0.9rem;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
    padding-bottom: var(--space-xl);
    flex-wrap: wrap;
  }

  .footer-identity {
    max-width: 330px;
    flex: 0 0 auto;
  }

  .footer-identity a {
    display: inline-block;
    transition: opacity var(--transition-fast);
  }

  .footer-identity a:hover {
    opacity: 0.8;
  }

  .footer-identity img {
    display: block;
    height: 52px;
    width: auto;
    filter: brightness(0) invert(1) opacity(0.92);
    margin-bottom: var(--space-sm);
  }

  .footer-identity .slogan {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-paper);
    margin-bottom: var(--space-xs);
  }

  .footer-nav {
    display: flex;
    gap: 2rem;
    flex: 1 1 auto;
    justify-content: flex-end;
  }

  .nav-column h4 {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-paper);
    margin-bottom: var(--space-sm);
  }

  .nav-column ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .nav-column a:hover {
    color: var(--color-paper);
    text-decoration: underline;
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding: var(--space-md) 0;
    text-align: center;
  }

  @media (max-width: 768px) {
    .footer-top {
      flex-direction: column;
    }
    .footer-nav {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>