---
import logoSrc from '../assets/logos/sl-softlenx-logo.svg';
---
<footer class="main-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-identity">
        <a href="/" aria-label="Retour à l'accueil de Softlenx">
          <img src={logoSrc.src} alt="Logo Softlenx" />
        </a>
        <p class="slogan">Au-delà des chiffres.</p>
        <p class="description">Média de démocratisation de l'information socioéconomique au Bénin.</p>
        <div class="social-links" aria-label="Réseaux sociaux">
          <a href="#" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm5 3.5A4.5 4.5 0 1 1 7.5 12 4.5 4.5 0 0 1 12 7.5Zm0 2A2.5 2.5 0 1 0 14.5 12 2.5 2.5 0 0 0 12 9.5Zm5-3.25a1.25 1.25 0 1 1-1.25 1.25A1.25 1.25 0 0 1 17 6.25Z"/></svg>
          </a>
          <a href="#" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 22v-8h2.7l.4-3h-3.1V7.5c0-.9.3-1.5 1.6-1.5H17V3.1c-.3 0-1.3-.1-2.4-.1-2.4 0-4.1 1.5-4.1 4.2V11H8v3h2.5v8h3Z"/></svg>
          </a>
          <a href="#" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.94 8.5A1.56 1.56 0 1 1 6.9 5.4a1.56 1.56 0 0 1 .04 3.1ZM5.5 10.2h2.9V19H5.5Zm5.2 0h2.8v1.2h.04c.4-.74 1.38-1.52 2.84-1.52 3 0 3.56 2 3.56 4.58V19h-2.9v-17.8c0-1.9-.04-4.4-2.68-4.4-2.7 0-3.12 2.1-3.12 4.27V19h-2.9Z"/></svg>
          </a>
          <a href="#" target="_blank" rel="noopener noreferrer" aria-label="X">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 2h3.5l-7.7 8.8L22.7 22h-6.9l-5.4-7.8L4.6 22H1l8.2-9.4L1.3 2h7.1l4.9 7.1L18.9 2Zm-1.2 18h1.9L7.1 3.9H5.1L17.7 20Z"/></svg>
          </a>
        </div>
      </div>
      <div class="footer-nav">
        <div class="nav-column">
          <h4>Navigation</h4>
          <ul>
            <li><a href="#mission">La mission</a></li>
            <li><a href="#demarche">La démarche</a></li>
            <li><a href="#thematiques">Les thématiques</a></li>
            <li><a href="#exigences">Nos exigences</a></li>
            <li><a href="#suivre">Nous suivre</a></li>
          </ul>
        </div>
        <div class="nav-column">
          <h4>Informations</h4>
          <ul>
            <li><a href="#">À propos</a></li>
            <li><a href="#">Contact</a></li>
            <li><a href="#">Politique de confidentialité</a></li>
            <li><a href="#">Politique relative aux cookies</a></li>
            <li><a href="#">Mentions légales</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} Softlenx. Tous droits réservés.</p>
    </div>
  </div>
</footer>

<style>
  .main-footer {
    background-color: var(--color-ink-navy);
    color: rgba(247, 245, 240, 0.7); /* Paper à 70% */
    padding-top: var(--space-xl);
    font-size: 0.9rem;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    gap: var(--space-xl);
    padding-bottom: var(--space-xl);
    flex-wrap: wrap;
  }

  .footer-identity {
    max-width: 340px;
  }

  .footer-identity a {
    display: inline-block;
    transition: opacity var(--transition-fast);
  }

  .footer-identity a:hover {
    opacity: 0.8;
  }

  .footer-identity img {
    display: block;
    height: 52px;
    width: auto;
    filter: brightness(0) invert(1) opacity(0.92);
    margin-bottom: var(--space-sm);
  }

  .social-links {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-md);
    flex-wrap: wrap;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(247, 245, 240, 0.3);
    border-radius: 50%;
    color: var(--color-paper);
    background: rgba(255, 255, 255, 0.02);
    transition: background-color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
  }

  .social-links a:hover {
    background-color: var(--color-accent-primary);
    border-color: var(--color-accent-primary);
    transform: translateY(-2px);
  }

  .social-links svg {
    width: 1rem;
    height: 1rem;
    fill: currentColor;
  }

  .footer-identity .slogan {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-paper);
    margin-bottom: var(--space-xs);
  }

  .footer-nav {
    display: flex;
    gap: var(--space-xl);
  }

  .nav-column h4 {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-paper);
    margin-bottom: var(--space-sm);
  }

  .nav-column ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .nav-column a:hover {
    color: var(--color-paper);
    text-decoration: underline;
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding: var(--space-md) 0;
    text-align: center;
  }

  @media (max-width: 768px) {
    .footer-top {
      flex-direction: column;
    }
    .footer-nav {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>